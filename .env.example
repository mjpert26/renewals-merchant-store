# Copy to .env.local for local overrides. Nothing here is required for the local demo.

# Signs session cookies. Required in production (32+ characters):
#   openssl rand -hex 32
SESSION_SECRET=

# Demo mode enables the persona sign-in screen, simulated funding and demo labels.
# Set to "false" once a real identity provider is connected.
DEMO_MODE=true

# SQLite database file. Defaults to ./data/rewards.db (created and seeded on first run).
REWARDS_DB_PATH=

# Bearer token required by /api/integrations/funding-events and /release.
# Leave empty to keep the integration endpoints disabled (they return 503).
FUNDING_WEBHOOK_SECRET=
